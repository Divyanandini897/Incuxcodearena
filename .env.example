# ── Judge0 CE API (code execution engine) ─────────────────────
JUDGE0_API_URL="http://localhost:2358"
JUDGE0_AUTH_TOKEN=""

# ── Redis Cache (optional — leave empty to disable) ───────────
REDIS_URL=""
REDIS_CACHE_TTL="3600"

# ── Gemini AI API ─────────────────────────────────────────────
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── App URL (for OAuth callbacks, self-referential links) ─────
APP_URL="MY_APP_URL"

# ── JDoodle Compiler API (legacy) ─────────────────────────────
JDOODLE_CLIENT_ID="your_client_id_here"
JDOODLE_CLIENT_SECRET="your_client_secret_here"

# ── Resend (email notifications) ──────────────────────────────
RESEND_API_KEY="re_..."

# ── SMTP / Email (for OTP delivery) ──────────────────────────
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587
# Mailgun: SMTP_HOST=smtp.mailgun.org, SMTP_PORT=587
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@yourdomain.com"

# ── OAuth (Google / GitHub) ──────────────────────────────────
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# ── Supabase Auth ─────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
