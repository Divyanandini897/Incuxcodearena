# ╔══════════════════════════════════════════════════════════════╗
# ║  SMTP / Email — for OTP delivery                            ║
# ║                                                              ║
# ║  Gmail requires an App Password (NOT your normal password).  ║
# ║                                                              ║
# ║  How to generate one:                                        ║
# ║  1. Go to https://myaccount.google.com/security              ║
# ║  2. Under "How you sign in to Google" → "2-Step Verification"║
# ║     → Enable it (you'll need your phone)                     ║
# ║  3. Go to https://myaccount.google.com/apppasswords          ║
# ║  4. Select "Mail" → "Other" → name it "LeetCode Clone"      ║
# ║  5. Click "Generate"                                         ║
# ║  6. COPY THE 16-CHAR CODE (looks like: abcd efgh ijkl mnop) ║
# ║  7. Paste it as SMTP_PASSWORD below (remove spaces)          ║
# ║                                                              ║
# ║  ⚠  NEVER paste your normal Gmail password here.             ║
# ╚══════════════════════════════════════════════════════════════╝

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=incuxcodearena@gmail.com
SMTP_PASSWORD=kckmbylugnfkiinp
FROM_EMAIL=incuxcodearena@gmail.com

# ╔══════════════════════════════════════════════════════════════╗
# ║  GitHub OAuth — configure INSIDE Supabase Dashboard         ║
# ║                                                              ║
# ║  Do NOT configure these as .env vars — they go into          ║
# ║  Supabase Dashboard → Authentication → Providers → GitHub.  ║
# ║                                                              ║
# ║  Step-by-step:                                               ║
# ║  1. Go to https://github.com/settings/developers             ║
# ║  2. New OAuth App →                                         ║
# ║     Homepage URL:  http://localhost:3000                     ║
# ║     Callback URL:  https://dhztrmngzxlmmarrvllq.supabase.co/auth/v1/callback ║
# ║     (↑ copy this from Supabase Dashboard → Authentication   ║
# ║       → Providers → GitHub → Callback URL (auto-generated)) ║
# ║  3. Copy Client ID and generate Client Secret               ║
# ║  4. Paste them into Supabase Dashboard → GitHub Provider    ║
# ║  5. Add http://localhost:3000/auth/callback to               ║
# ║     Supabase Dashboard → Authentication → Settings →        ║
# ║     Redirect URLs                                            ║
# ╚══════════════════════════════════════════════════════════════╝

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ╔══════════════════════════════════════════════════════════════╗
