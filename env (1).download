# ║  Same as GitHub: put Client ID + Secret in Supabase,         ║
# ║  NOT in .env.local.                                          ║
# ║                                                              ║
# ║  Google Cloud Console → APIs & Services → Credentials →      ║
# ║  OAuth 2.0 Client IDs → Web application:                     ║
# ║  Authorized redirect URIs:                                  ║
# ║  https://dhztrmngzxlmmarrvllq.supabase.co/auth/v1/callback  ║
# ╚══════════════════════════════════════════════════════════════╝

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

